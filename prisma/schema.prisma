generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// User / Customer
// ============================================
model User {
  id        String   @id @default(uuid())
  phone     String   @unique
  name      String?
  kycStatus String   @default("none") // none | pending | verified
  status    String   @default("active") // active | flagged | blocked
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile       UserProfile?
  bankAccount   BankAccount?
  credentials   UserCredential?
  sessions      UserSession[]
  transactions  Transaction[]
  wallets       Wallet[]
}

// ============================================
// User Profile (PII)
// ============================================
model UserProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  firstName String?
  lastName  String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// Bank Account (created by AutoRamp)
// ============================================
model BankAccount {
  id            String  @id @default(uuid())
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id])
  autorampSubId String? @unique
  reference     String? @unique
  accountNumber String?
  accountName   String?
  bankCode      String?
  bankName      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============================================
// User Credentials (PIN + identity verification)
// ============================================
model UserCredential {
  id         String   @id @default(uuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id])
  bvn        String?
  nin        String?
  identityId String?
  pin        String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ============================================
// WhatsApp conversation session state
// ============================================
model UserSession {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  state        String   @default("idle")
  flowData     Json     @default("{}")   // temporary data for current flow
  lastActivity DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

// ============================================
// Transactions (transfers, on-ramp, off-ramp, etc.)
// ============================================
model Transaction {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  reference       String   @unique
  type            String                     // transfer | onramp | offramp | swap
  amount          Float
  currency        String   @default("NGN")
  status          String   @default("pending") // pending | processing | completed | failed
  description     String?
  metadata        Json     @default("{}")
  autorampRef     String?                    // AutoRamp transaction reference
  bankCode        String?
  bankAccount     String?
  bankName        String?
  accountName     String?
  recipientPhone  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([reference])
}

// ============================================
// Wallet (per-user, per-currency balance)
// ============================================
model Wallet {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  currency  String   @default("RWF")
  balance   Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledgerEntries LedgerEntry[]

  @@unique([userId, currency])
  @@index([userId])
}

// ============================================
// Ledger (internal source of truth for balances)
// Each entry records a change and the running balance after it.
// ============================================
model LedgerEntry {
  id             String   @id @default(uuid())
  walletId       String
  wallet         Wallet   @relation(fields: [walletId], references: [id])
  direction      String   // credit | debit
  amount         Float
  currency       String   @default("RWF")
  runningBalance Float    // balance in the wallet after this entry
  reference      String   // external tx ref (tx_ref, transfer ref, etc.)
  description    String?
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())

  @@index([walletId])
  @@index([reference])
}

// ============================================
// Webhook event log (idempotency)
// ============================================
model WebhookEvent {
  id        String   @id @default(uuid())
  source    String                     // whatsapp | autoramp
  eventType String
  reference String?
  payload   Json
  processed Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([source, eventType, reference])
}
