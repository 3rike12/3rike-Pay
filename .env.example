# ============================================
# 3rike Pay - WhatsApp Payment Bot
# ============================================
# Copy this to .env and fill in your values

# Server
PORT=3000
NODE_ENV=development

# Database - wired from env
# DEV (sqlite): DATABASE_URL=file:./prisma/dev.db  + npm run db:push:sqlite
# PROD (postgres): DATABASE_URL=postgresql://... + npm run db:push
DATABASE_URL=file:./prisma/dev.db

# Redis (optional but recommended for sessions + pending transfer state)
# If not set, sessions fall back to the database.
# REDIS_URL=redis://localhost:6379

# WhatsApp Business API
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token

# Webhook
WEBHOOK_PATH=/webhook/whatsapp
WEBHOOK_SECRET=your_webhook_secret

# AutoRamp API
AUTORAMP_API_KEY=your_api_key_here
AUTORAMP_BASE_URL=https://api-autoramp.thebuidl.xyz
AUTORAMP_WEBHOOK_SECRET=your_autoramp_webhook_secret

# Original Nigerian-banking features (KYC, send to bank, airtime). Off by default.
# LEGACY_BANKING_ENABLED=true
# Identity check (BVN/NIN + OTP via AutoRamp). Off by default; nothing is requested or verified.
# KYC_REQUIRED=true

# Mobile money invoice collection (Flutterwave). Off by default; new invoices go via crypto.
# MOBILE_MONEY_ENABLED=true

# Flutterwave API
# Get keys from https://dashboard.flutterwave.com/dashboard/settings/apis
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_WEBHOOK_SECRET=your_flutterwave_webhook_secret_hash
# Set to true for live transactions; false/empty uses Flutterwave sandbox
FLUTTERWAVE_PRODUCTION=false
# v4 API credentials (Client ID / Client Secret) - Dashboard > Settings > API Keys
# > "Switch to v4 live API keys". Powers the push-notification charge flow;
# leave empty to fall back to the v3 redirect-link charge.
FLUTTERWAVE_CLIENT_ID=
FLUTTERWAVE_CLIENT_SECRET=
# Sandbox testing only: sent as X-Scenario-Key on charges. Use
# scenario:auth_redirect so a test charge returns Flutterwave's mock
# approval page (mock numbers never authorise a push). Leave empty in
# production.
FLUTTERWAVE_SCENARIO_KEY=
# Subaccount split: how much of each collection is routed to the merchant subaccount.
# TYPE can be "percentage" or "flat". VALUE is the merchant share (e.g. 0.95 = 95%).
FLUTTERWAVE_SPLIT_TYPE=percentage
FLUTTERWAVE_SPLIT_VALUE=0.95

# Public origin of this server; enables buyer pay links in WhatsApp (e.g. https://pay.example.com)
# PUBLIC_BASE_URL=

# NEAR Intents (crypto invoice payments) - API key from the NEAR Intents Partner Dashboard
# Enabled only when NEAR_INTENTS_API_KEY and NEAR_INTENTS_RECIPIENT are both set.
NEAR_INTENTS_API_KEY=
# Platform-controlled address on the destination chain that receives swapped funds
NEAR_INTENTS_RECIPIENT=
# NEAR-native treasury (hackathon setup): USDC delivered into an Intents account
# NEAR_INTENTS_RECIPIENT=your-treasury.near
# NEAR_INTENTS_RECIPIENT_TYPE=INTENTS
# NEAR_INTENTS_DESTINATION_ASSET=nep141:17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1
# NEAR_INTENTS_REFUND_TO=
# NEAR_INTENTS_ORIGIN_ASSET=nep141:base-0x833589fcd6edb6e08f4c7c32d4f71b54bda02913.omft.near
# NEAR_INTENTS_DESTINATION_ASSET=nep141:base-0x833589fcd6edb6e08f4c7c32d4f71b54bda02913.omft.near
# NEAR_INTENTS_DESTINATION_DECIMALS=6
# Units per 1 USD, merges over built-in USD/RWF/NGN/KES/GHS defaults
# NEAR_INTENTS_FX_RATES={"RWF":1450,"NGN":1550}
# NEAR_INTENTS_SLIPPAGE_BPS=100

# Crypto treasury (backs merchant balances; payouts leave from here)
# TREASURY_ADDRESS defaults to NEAR_INTENTS_RECIPIENT.
# TREASURY_ADDRESS=
# TREASURY_RPC_URL=https://mainnet.base.org
# WITHDRAW_MIN_USD=5
# WITHDRAW_MAX_USD=2000

# App
APP_NAME=3rike Pay
APP_CURRENCY=NGN
MERCHANT_EMAIL=merchant@example.com
MERCHANT_NAME=3rike Pay

# Logging
LOG_LEVEL=debug

# WhatsApp Flows - source of truth is src/config/flows.json
# (design ids + cta + firstScreen there). These env vars are optional
# overrides per environment; leave unset to use the JSON values.
# WHATSAPP_FLOW_KYC_ID=your_kyc_flow_id
# WHATSAPP_FLOW_SEND_MONEY_ID=your_send_money_flow_id
# WHATSAPP_FLOW_AIRTIME_ID=your_airtime_flow_id
# WHATSAPP_FLOW_BUSINESS_ID=your_business_flow_id

# WhatsApp Message Templates - source of truth is src/config/templates.json
# (design names + language + params there; must match Meta approval).
# Only templates that are actually sent outside the 24h window need env overrides.
# Leave unset to use the JSON values.
# WHATSAPP_TEMPLATE_LANG=en
# WHATSAPP_TEMPLATE_WELCOME=onboarding_message
# WHATSAPP_TEMPLATE_TRANSFER_COMPLETE=transfer_complete
# WHATSAPP_TEMPLATE_TRANSFER_FAILED=transfer_failed

# KYC Dry-run mode (no AutoRamp calls, no DB writes, fake account number)
# Legacy alias: KYC_DRY_RUN also works. New projects should use DRY_RUN.
DRY_RUN=false
# KYC_DRY_RUN=false

# WhatsApp Flow Encryption Private Key
# Used to decrypt/encrypt WhatsApp Flow payloads.
# Priority: FLOW_PRIVATE_KEY (single-line PEM) > FLOW_PRIVATE_KEY_BASE64 > FLOW_PRIVATE_KEY_PATH (file).
# For deployment, set FLOW_PRIVATE_KEY_BASE64 (no newlines) or FLOW_PRIVATE_KEY (single-line PEM);
# keep the file path for local dev.
# FLOW_PRIVATE_KEY=-----BEGIN PRIVATE KEY----- MII...== -----END PRIVATE KEY-----
# FLOW_PRIVATE_KEY_BASE64=<base64-encoded PEM>
# FLOW_PRIVATE_KEY_PATH=/path/to/flow_private.pem
# FLOW_PRIVATE_KEY_PASSPHRASE=your_key_passphrase

# KYC Page URL (used in WhatsApp template links)
KYC_BASE_URL=https://yourdomain.com
