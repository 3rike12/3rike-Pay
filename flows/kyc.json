{
  "version": "7.0",
  "data_api_version": "3.0",
  "routing_model": {
    "IDENTITY": ["EMAIL"],
    "EMAIL": ["NAME"],
    "NAME": ["OTP"],
    "OTP": ["PIN"],
    "PIN": ["END"],
    "END": [],
    "COMPLETED": []
  },
  "screens": [
    {
      "id": "IDENTITY",
      "title": "Verify your identity",
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextBody",
            "text": "Choose an ID to verify with. What you type here stays private - it is never shown in the chat."
          },
          {
            "type": "Form",
            "name": "identity_form",
            "children": [
              {
                "type": "RadioButtonsGroup",
                "name": "id_type",
                "label": "ID type",
                "required": true,
                "data-source": [
                  { "id": "NIN", "title": "NIN", "description": "National Identification Number" },
                  { "id": "BVN", "title": "BVN", "description": "Bank Verification Number" }
                ]
              },
              {
                "type": "TextInput",
                "name": "id_number",
                "label": "ID number",
                "input-type": "number",
                "required": true,
                "helper-text": "11 digits"
              },
              {
                "type": "Footer",
                "label": "Continue",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "id_type": "${form.id_type}",
                    "id_number": "${form.id_number}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "EMAIL",
      "title": "Email address",
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextBody", "text": "Enter your email address. We will send account updates here." },
          {
            "type": "Form",
            "name": "email_form",
            "children": [
              {
                "type": "TextInput",
                "name": "email",
                "label": "Email",
                "input-type": "email",
                "required": true
              },
              {
                "type": "Footer",
                "label": "Continue",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": { "email": "${form.email}" }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "NAME",
      "title": "Your name",
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextBody", "text": "Enter your first and last name as it appears on your ID." },
          {
            "type": "Form",
            "name": "name_form",
            "children": [
              {
                "type": "TextInput",
                "name": "first_name",
                "label": "First name",
                "required": true
              },
              {
                "type": "TextInput",
                "name": "last_name",
                "label": "Last name",
                "required": true
              },
              {
                "type": "Footer",
                "label": "Continue",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "first_name": "${form.first_name}",
                    "last_name": "${form.last_name}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "OTP",
      "title": "Enter your code",
      "data": {
        "message": {
          "type": "string",
          "__example__": "We sent a code to the phone number registered to your ID."
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextBody", "text": "${data.message}" },
          {
            "type": "Form",
            "name": "otp_form",
            "children": [
              {
                "type": "TextInput",
                "name": "otp",
                "label": "Verification code",
                "input-type": "number",
                "required": true
              },
              {
                "type": "Footer",
                "label": "Verify",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": { "otp": "${form.otp}" }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "PIN",
      "title": "Create PIN",
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextBody", "text": "Create a 4-digit PIN. You will use it to log in and authorize transactions." },
          {
            "type": "Form",
            "name": "pin_form",
            "children": [
              {
                "type": "TextInput",
                "name": "pin",
                "label": "4-digit PIN",
                "input-type": "number",
                "required": true
              },
              {
                "type": "TextInput",
                "name": "confirm_pin",
                "label": "Confirm PIN",
                "input-type": "number",
                "required": true
              },
              {
                "type": "Footer",
                "label": "Create PIN",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "pin": "${form.pin}",
                    "confirm_pin": "${form.confirm_pin}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "END",
      "title": "Done",
      "terminal": true,
      "success": true,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "Done" },
          { "type": "TextBody", "text": "Close this form and check your WhatsApp chat for your account details." },
          {
            "type": "Form",
            "name": "close_form",
            "children": [
              {
                "type": "Footer",
                "label": "Close",
                "on-click-action": {
                  "name": "complete",
                  "payload": {}
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "COMPLETED",
      "title": "Already verified",
      "terminal": true,
      "success": true,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "Already verified" },
          { "type": "TextBody", "text": "Your identity has already been verified. No need to do this again." }
        ]
      }
    }
  ]
}
