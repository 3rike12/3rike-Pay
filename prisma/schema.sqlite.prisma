// ============================================
// DEV-ONLY schema: SQLite (local file, no server).
// Prod uses prisma/schema.prisma (PostgreSQL).
// Which one applies is wired from the env:
//   DATABASE_URL=file:./dev.db  -> npm run db:push:sqlite (this file)
//   DATABASE_URL=postgresql://.. -> npm run db:push        (schema.prisma)
// Models are kept identical between the two files - change both.
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// User / Customer
// ============================================
model User {
  id        String   @id @default(uuid())
  phone     String   @unique
  name      String?
  kycStatus String   @default("none") // none | pending | verified
  status    String   @default("active") // active | flagged | blocked
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile       UserProfile?
  bankAccount   BankAccount?
  credentials   UserCredential?
  sessions      UserSession[]
  transactions  Transaction[]
  wallets       Wallet[]
  business      Business?
  flutterwaveSubaccounts FlutterwaveSubaccount[]
  products      Product[]
  invoices      Invoice[]
}

// ============================================
// User Profile (PII)
// ============================================
model UserProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  firstName String?
  lastName  String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// Bank Account (created by AutoRamp)
// ============================================
model BankAccount {
  id            String  @id @default(uuid())
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id])
  autorampSubId String? @unique
  reference     String? @unique
  accountNumber String?
  accountName   String?
  bankCode      String?
  bankName      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============================================
// User Credentials (PIN + identity verification)
// ============================================
model UserCredential {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  bvn       String?
  nin       String?
  identityId String?
  pin       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// WhatsApp conversation session state
// ============================================
model UserSession {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  state        String   @default("idle")
  flowData     Json                  // temporary data for current flow
  lastActivity DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

// ============================================
// Transactions (transfers, on-ramp, off-ramp, etc.)
// ============================================
model Transaction {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  reference       String   @unique
  type            String                     // transfer | onramp | offramp | swap | invoice
  amount          Float
  currency        String   @default("NGN")
  status          String   @default("pending") // pending | processing | completed | failed
  description     String?
  metadata        Json
  autorampRef     String?                    // AutoRamp transaction reference
  bankCode        String?
  bankAccount     String?
  bankName        String?
  accountName     String?
  recipientPhone  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([reference])
}

// ============================================
// Wallet (per-user, per-currency balance)
// ============================================
model Wallet {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  currency  String   @default("RWF")
  balance   Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledgerEntries LedgerEntry[]

  @@unique([userId, currency])
  @@index([userId])
}

// ============================================
// Ledger (internal source of truth for balances)
// Each entry records a change and the running balance after it.
// ============================================
model LedgerEntry {
  id             String   @id @default(uuid())
  walletId       String
  wallet         Wallet   @relation(fields: [walletId], references: [id])
  direction      String   // credit | debit
  amount         Float
  currency       String   @default("RWF")
  runningBalance Float    // balance in the wallet after this entry
  reference      String   // external tx ref (tx_ref, transfer ref, etc.)
  description    String?
  metadata       Json
  createdAt      DateTime @default(now())

  @@index([walletId])
  @@index([reference])
}

// ============================================
// Business / Merchant profile (one-to-one with User)
// ============================================
model Business {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id])
  name               String
  email              String?
  phone              String?
  country            String   @default("RW")
  registrationNumber String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ============================================
// Flutterwave subaccount per user + currency (one-to-many with User)
// ============================================
model FlutterwaveSubaccount {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  subaccountId  String   // Flutterwave's RS_... id
  accountBank   String
  accountNumber String
  businessName  String
  businessEmail String
  currency      String   @default("RWF")
  country       String   @default("RW")
  splitType     String   @default("percentage")
  splitValue    Float    @default(0.95)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, currency])
  @@index([userId])
}

// ============================================
// Product (merchant catalogue, created in chat)
// ============================================
model Product {
  id          String   @id @default(uuid())
  merchantId  String
  merchant    User     @relation(fields: [merchantId], references: [id])
  name        String
  price       Float
  currency    String   @default("RWF")
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([merchantId])
}

// ============================================
// Invoice / payment request (order summary sent to a buyer)
//
// `id` and `reference` are INTERNAL trace only - buyers never see either.
// `reference` doubles as the Flutterwave tx_ref and joins 1:1 to
// Transaction.reference, which is what the charge webhook looks up.
// ============================================
model Invoice {
  id         String    @id @default(uuid())
  merchantId String
  merchant   User      @relation(fields: [merchantId], references: [id])
  buyerPhone String                           // 10-digit national Rwanda form (078...)
  items      Json                             // [{ name, qty, unitPrice }] snapshot at issue
  amount     Float                            // sum(qty * unitPrice)
  currency   String    @default("RWF")
  reference  String    @unique                // = Flutterwave tx_ref
  status     String    @default("draft")      // draft | sent | pending_payment | paid | expired | failed | cancelled
  paymentUrl String?                          // Flutterwave meta.authorization.redirect
  paidAt     DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([merchantId])
  @@index([reference])
  @@index([status])
}

// ============================================
// Webhook event log (idempotency)
// ============================================
model WebhookEvent {
  id        String   @id @default(uuid())
  source    String                     // whatsapp | autoramp
  eventType String
  reference String?
  payload   Json
  processed Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([source, eventType, reference])
}
