# ============================================
# 3rike Pay - WhatsApp Payment Bot
# ============================================
# Copy this to .env and fill in your values

# Server
PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/threerike_pay

# WhatsApp Business API
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token

# Webhook
WEBHOOK_PATH=/webhook/whatsapp
WEBHOOK_SECRET=your_webhook_secret

# AutoRamp API
AUTORAMP_API_KEY=your_api_key_here
AUTORAMP_BASE_URL=https://autoramp-api.thebuidl.org
AUTORAMP_WEBHOOK_SECRET=your_autoramp_webhook_secret

# App
APP_NAME=3rike Pay
APP_CURRENCY=NGN
MERCHANT_EMAIL=merchant@example.com
MERCHANT_NAME=3rike Pay

# Logging
LOG_LEVEL=debug

# KYC Page URL (used in WhatsApp template links)
KYC_BASE_URL=https://yourdomain.com
