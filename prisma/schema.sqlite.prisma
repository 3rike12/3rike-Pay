// ============================================
// DEV-ONLY schema: SQLite (local file, no server).
// Prod uses prisma/schema.prisma (PostgreSQL).
// Which one applies is wired from the env:
//   DATABASE_URL=file:./dev.db  -> npm run db:push:sqlite (this file)
//   DATABASE_URL=postgresql://.. -> npm run db:push        (schema.prisma)
// Models are kept identical between the two files - change both.
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// User / Customer
// ============================================
model User {
  id        String   @id @default(uuid())
  phone     String   @unique
  name      String?
  kycStatus String   @default("none") // none | pending | verified
  status    String   @default("active") // active | flagged | blocked
  currency           String?  // balance currency the user picked: KES | TZS | NGN (null = default)
  privyUserId        String?
  privyWalletId      String?
  privyWalletAddress String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile       UserProfile?
  bankAccount   BankAccount?
  credentials   UserCredential?
  sessions      UserSession[]
  transactions  Transaction[]
  wallets       Wallet[]
  business      Business?
  flutterwaveSubaccounts FlutterwaveSubaccount[]
  products      Product[]
  invoices      Invoice[]
}

// ============================================
// User Profile (PII)
// ============================================
model UserProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  firstName String?
  lastName  String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// Bank Account (created by AutoRamp)
// ============================================
model BankAccount {
  id            String  @id @default(uuid())
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id])
  autorampSubId String? @unique
  reference     String? @unique
  accountNumber String?
  accountName   String?
  bankCode      String?
  bankName      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============================================
// User Credentials (PIN + identity verification)
// ============================================
model UserCredential {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  bvn       String?
  nin       String?
  identityId String?
  pin       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// WhatsApp conversation session state
// ============================================
model UserSession {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  state        String   @default("idle")
  flowData     Json                  // temporary data for current flow
  lastActivity DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

// ============================================
// Transactions (transfers, on-ramp, off-ramp, etc.)
// ============================================
model Transaction {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  reference       String   @unique
  type            String                     // transfer | onramp | offramp | swap | invoice | wallet_topup
  amount          Float
  amountMinor     BigInt?                    // amount in minor units; null until written or backfilled
  currency        String   @default("NGN")
  status          String   @default("pending") // pending | processing | completed | failed
  description     String?
  metadata        Json
  autorampRef     String?                    // AutoRamp transaction reference
  bankCode        String?
  bankAccount     String?
  bankName        String?
  accountName     String?
  recipientPhone  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([reference])
}

// ============================================
// Wallet (per-user, per-currency balance)
// ============================================
model Wallet {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  currency  String   @default("RWF")
  balance   Float    @default(0)
  // Same balance as whole minor units (cents). Dual-written; the float is still the source of truth.
  balanceMinor BigInt @default(0)
  // user: what we owe a person. system: a counter-account (external, fx clearing, ...). Balance is
  // credits minus debits for both, so a balanced journal keeps every account together at zero.
  kind      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledgerEntries LedgerEntry[]

  @@unique([userId, currency])
  @@index([userId])
}

// ============================================
// Ledger (internal source of truth for balances)
// Each entry records a change and the running balance after it.
// ============================================
model LedgerEntry {
  id             String   @id @default(uuid())
  walletId       String
  wallet         Wallet   @relation(fields: [walletId], references: [id])
  direction      String   // credit | debit
  amount         Float
  currency       String   @default("RWF")
  runningBalance Float    // balance in the wallet after this entry
  amountMinor         BigInt @default(0) // amount in minor units (dual-written)
  runningBalanceMinor BigInt @default(0) // runningBalance in minor units (dual-written)
  reference      String   // external tx ref (tx_ref, transfer ref, etc.)
  description    String?
  metadata       Json
  // Makes a posting happen at most once, enforced by the database itself (not a cache that expires).
  // Null for postings made without one; unique among those that have one.
  idempotencyKey String?  @unique
  // The journal this entry belongs to: every journal's entries sum to zero per currency.
  // Null only for entries written before double-entry existed.
  journalId      String?
  journal        Journal? @relation(fields: [journalId], references: [id])
  createdAt      DateTime @default(now())

  @@index([walletId])
  @@index([reference])
  @@index([journalId])
}

// ============================================
// A journal: one movement of money, as two or more entries that balance (debits equal
// credits, per currency). It is the unit of idempotency: a journal with a given key
// exists at most once, and all of its entries are written, or none are.
// ============================================
model Journal {
  id             String   @id @default(uuid())
  reference      String
  description    String?
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())

  entries LedgerEntry[]

  @@index([reference])
}

// ============================================
// Business / Merchant profile (one-to-one with User)
// ============================================
model Business {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id])
  name               String
  email              String?
  phone              String?
  country            String   @default("RW")
  registrationNumber String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ============================================
// Flutterwave subaccount per user + currency (one-to-many with User)
// ============================================
model FlutterwaveSubaccount {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  subaccountId  String   // Flutterwave's RS_... id
  accountBank   String
  accountNumber String
  businessName  String
  businessEmail String
  currency      String   @default("RWF")
  country       String   @default("RW")
  splitType     String   @default("percentage")
  splitValue    Float    @default(0.95)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, currency])
  @@index([userId])
}

// ============================================
// Product (merchant catalogue, created in chat)
// ============================================
model Product {
  id          String   @id @default(uuid())
  merchantId  String
  merchant    User     @relation(fields: [merchantId], references: [id])
  name        String
  price       Float
  currency    String   @default("RWF")
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([merchantId])
}

// ============================================
// Invoice / payment request (order summary sent to a buyer)
//
// `id` and `reference` are INTERNAL trace only - buyers never see either.
// `reference` doubles as the Flutterwave tx_ref and joins 1:1 to
// Transaction.reference, which is what the charge webhook looks up.
// ============================================
model Invoice {
  id         String    @id @default(uuid())
  merchantId String
  merchant   User      @relation(fields: [merchantId], references: [id])
  buyerPhone String                           // 10-digit national Rwanda form (078...)
  items      Json                             // [{ name, qty, unitPrice }] snapshot at issue
  amount     Float                            // sum(qty * unitPrice)
  currency   String    @default("RWF")
  reference  String    @unique                // = Flutterwave tx_ref
  status     String    @default("draft")      // draft | sent | pending_payment | paid | expired | failed | cancelled
  paymentUrl String?                          // Flutterwave meta.authorization.redirect
  paidAt     DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([merchantId])
  @@index([reference])
  @@index([status])
}

// ============================================
// Webhook event log (idempotency)
// ============================================
model WebhookEvent {
  id        String   @id @default(uuid())
  source    String                     // whatsapp | autoramp
  eventType String
  reference String?
  payload   Json
  processed Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([source, eventType, reference])
}

// ============================================
// Payment intents (one row per movement of money, across every rail)
// `state` is the canonical state from src/rails/types.ts. RailEvent is the
// append-only record of what each rail reported.
// ============================================
model PaymentIntent {
  id        String   @id @default(uuid())
  reference String   @unique
  direction String                       // in | out
  kind      String                       // invoice | topup | withdrawal | cashout
  userId    String?
  rail      String                       // 1click | autoramp | ...
  railRef   String?
  state     String   @default("created") // created | awaiting_funds | processing | settled | refunded | failed | expired
  // Set while a direct USDC payment is open: the exact tagged amount that identifies it
  // (usdc-base:<units>). Unique, so two open payments can never share an amount. Cleared when final.
  openKey   String?  @unique
  payload   Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events RailEvent[]

  @@index([state])
  @@index([userId])
}

model RailEvent {
  id             String        @id @default(uuid())
  intentId       String
  intent         PaymentIntent @relation(fields: [intentId], references: [id])
  rail           String
  type           String                  // canonical state the rail reported
  providerStatus String
  dedupeKey      String        @default("")
  applied        Boolean       @default(true) // false: refused as a conflict, kept for audit
  detail         Json          @default("{}")
  receivedAt     DateTime      @default(now())

  @@unique([intentId, type, dedupeKey])
  @@index([intentId])
}

// Where a rail's on-chain scanner got to, so a restart resumes instead of rescanning or skipping.
model RailCursor {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ============================================
// Stock positions (who owns how much of each tokenized stock)
// The treasury holds the tokens in one wallet; these rows say whose they are.
// Units are RAW token units (the token's own decimals), whole numbers, never floats.
// A position is only ever changed by a PositionEntry, so the entries always explain it.
// ============================================
model StockPosition {
  id           String   @id @default(uuid())
  userId       String
  tokenAddress String                      // lower-case 0x address: the identity
  units        BigInt   @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  entries PositionEntry[]

  @@unique([userId, tokenAddress])
  @@index([userId])
  @@index([tokenAddress])
}

model PositionEntry {
  id             String        @id @default(uuid())
  positionId     String
  position       StockPosition @relation(fields: [positionId], references: [id])
  direction      String                    // credit | debit
  units          BigInt
  runningUnits   BigInt                    // the position right after this entry
  reference      String                    // the order this belongs to
  description    String?
  metadata       Json
  // Makes a posting happen at most once, enforced by the database.
  idempotencyKey String?       @unique
  createdAt      DateTime      @default(now())

  @@index([positionId])
  @@index([reference])
}

// ============================================
// Stock orders: one row per buy or sell, driven through guarded states so a crash
// at any point resumes without a double debit or credit.
//   buy:  created -> funded (cash debited) -> submitted (sent to the venue) -> filled | refunded
//   sell: created -> funded (units debited) -> submitted -> filled | refunded
//   failed: nothing was debited (e.g. not enough cash). An order whose outcome at
//   the venue is unknown STAYS submitted: it is never refunded on a guess.
// ============================================
model StockOrder {
  id              String   @id @default(uuid())
  reference       String   @unique          // our id, and the venue's client order id
  userId          String
  side            String                    // buy | sell
  tokenAddress    String
  tokenDecimals   Int
  currency        String                    // the user's balance currency
  cashAmount      Float                     // buy: debited from the user; sell: credited on fill
  cashAmountMinor BigInt   @default(0)
  usdcUnits       BigInt   @default(0)      // buy: USDC to spend; sell: USDC received (set on fill)
  tokenUnits      BigInt   @default(0)      // buy: units received (set on fill); sell: units sold
  minTokenUnits   BigInt   @default(0)      // buy: the floor sent to the venue
  minUsdcUnits    BigInt   @default(0)      // sell: the floor sent to the venue
  state           String   @default("created") // created | funded | submitted | filled | refunded | failed
  venue           String
  txHash          String?
  failure         String?
  fx              Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([state])
}

// ============================================
// Recurring stock buys ("buy 2000 of Apple every Friday"). Runs at 08:00 UTC.
// Each run places an order whose reference is derived from the schedule and the
// scheduled time, so a crash and retry resumes the same order instead of making
// another. `nextRunAt` is advanced by a guarded update, so only one worker does.
// ============================================
model StockSchedule {
  id            String    @id @default(uuid())
  reference     String    @unique          // the confirmation that created it: creating twice makes one
  userId        String
  tokenAddress  String
  tokenDecimals Int
  ticker        String
  name          String
  cashAmount    Float
  currency      String
  frequency     String                      // daily | weekly | monthly
  weekday       Int?                        // 0 = Sunday .. 6 = Saturday
  dayOfMonth    Int?                        // 1..28
  state         String    @default("active") // active | paused | cancelled
  nextRunAt     DateTime
  lastRunAt     DateTime?
  failures      Int       @default(0)       // consecutive; three pause it
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([state, nextRunAt])
  @@index([userId])
}

// ============================================
// Trades the treasury has sent to a venue. One row per order reference, written
// BEFORE the transaction is broadcast, so a crash can never lose track of a trade.
// ============================================
model VenueTrade {
  id           String   @id @default(uuid())
  reference    String   @unique          // our order reference: the venue's idempotency key
  venue        String
  side         String                    // buy | sell
  tokenAddress String
  sellAmount   BigInt                    // base units of what the treasury gives
  minBuyAmount BigInt                    // the floor the swap enforces on chain
  txHash       String?                   // null until the swap was handed to the signer
  state        String   @default("submitted") // submitted | filled | rejected
  failure      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([state])
}

// ============================================
// Stock alerts: what each token looked like last time we checked (so a change can
// be noticed), what we have already told each person (so nobody is told twice),
// and who asked not to be told.
// ============================================
model StockSnapshot {
  tokenAddress     String   @id
  multiplier       Float
  navPrice         Float?
  navUpdatedAt     String?
  refPrice         Float?                   // the price a move is measured from
  refAt            DateTime?
  lastMoveAlertAt  DateTime?
  pendingSince     DateTime?                // set while an alert could not be delivered to everyone
  updatedAt        DateTime @updatedAt
}

model StockAlert {
  id        String   @id @default(uuid())
  key       String   @unique                // kind:token:event:user - one alert per person per event
  userId    String
  kind      String                          // corporate_action | price_move
  createdAt DateTime @default(now())

  @@index([userId])
}

model StockAlertOptOut {
  userId    String   @id
  createdAt DateTime @default(now())
}

// ============================================
// Price history: one row per NEW price data point a token's feed published, so a
// trend and a drawdown can be computed from what we actually saw. Only the shape
// of the price matters (percent moves), never its absolute unit.
// ============================================
model StockPricePoint {
  id           String   @id @default(uuid())
  tokenAddress String
  price        Float
  observedAt   DateTime                  // when the feed says the price was set
  createdAt    DateTime @default(now())

  @@unique([tokenAddress, observedAt])
  @@index([tokenAddress, observedAt])
}
