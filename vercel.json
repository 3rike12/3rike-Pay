{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm --prefix web ci",
  "buildCommand": "npm --prefix web run build && node scripts/vercel-build.js",
  "outputDirectory": "web/dist",
  "rewrites": [
    { "source": "/pay", "destination": "/pay-home.html" },
    { "source": "/pay/favicon.png", "destination": "/mark.png" },
    { "source": "/pay/:ref", "destination": "/pay.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    { "source": "/config.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
