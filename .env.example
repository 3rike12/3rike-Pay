# ============================================
# 3rike Pay - environment variables
# ============================================
# Copy to .env for local runs. On Coolify, set these in the app's Environment
# tab instead (the compose file deliberately contains none of them).
#
# Section 1 is what the product needs to run. Everything after it is optional
# or only for a feature you turn on. Nothing secret is ever committed.

# ============================================
# 1. REQUIRED
# ============================================

# --- Database ---
# Coolify / Docker (Postgres): DATABASE_URL=postgresql://user:pass@host:5432/dbname
# Local demo (SQLite):         DATABASE_URL=file:./prisma/dev.db  + npm run db:push:sqlite
# The app runs `prisma db push` on boot, so this must point at a database you
# intend it to change.
DATABASE_URL=file:./prisma/dev.db

# --- Public URLs ---
# Where customers open pay links (the Vercel pay page).
PUBLIC_BASE_URL=https://pay.3rike.com
# This backend's own origin is https://api-pay.3rike.com (webhooks live under /webhook).

# --- WhatsApp Business API ---
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token
WEBHOOK_PATH=/webhook/whatsapp
WEBHOOK_SECRET=your_webhook_secret

# --- Crypto payments (NEAR Intents) ---
# Optional network selector: `near` (or `mainnet`) uses official 1Click;
# `tidepool` switches the local demo to Tidepool/Base Sepolia automatically.
# Tidepool reuses TREASURY_ADDRESS for incoming test tokens and the connected
# buyer wallet for refunds. Outbound payouts are disabled in Tidepool mode.
# NEAR_INTENTS_NETWORK=near
# Payments turn on when a recipient is known: the treasury wallet (an address on
# Base) that receives every customer's payment as USDC. If you leave this empty,
# TREASURY_ADDRESS below is used, so setting one of the two is enough.
NEAR_INTENTS_RECIPIENT=
# Optional. Without a key requests still work but pay a small extra fee (about 0.2%).
NEAR_INTENTS_API_KEY=

# --- Treasury (backs balances; payouts leave from here) ---
# Defaults to NEAR_INTENTS_RECIPIENT. Keep them the same address.
TREASURY_ADDRESS=

# ============================================
# 2. REDIS (provided by docker-compose; do not set REDIS_URL there)
# ============================================
# The compose file runs Redis and injects REDIS_URL itself. Redis turns on the
# durable payment queue (BullMQ) and the idempotency locks. Set it by hand only
# when running the app outside compose:
# REDIS_URL=redis://localhost:6379

# ============================================
# 3. SERVER
# ============================================
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# ============================================
# 4. PAYOUTS: cash out to a Nigerian bank (AutoRamp)
# ============================================
AUTORAMP_API_KEY=your_api_key_here
AUTORAMP_BASE_URL=https://api-autoramp.thebuidl.xyz
AUTORAMP_WEBHOOK_SECRET=your_autoramp_webhook_secret

# ============================================
# 5. TREASURY SIGNER (Privy server wallet)
# ============================================
# Leave all four unset to fund payouts by hand (`npm run cashout:pending`).
# Pair with a Privy policy: only the USDC contract on Base, value 0, per-tx cap.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_AUTHORIZATION_KEY=
PRIVY_TREASURY_WALLET_ID=
# true = Privy pays gas (needs app-pays sponsorship + credits); false = the wallet holds a little ETH on Base
PRIVY_SPONSOR_GAS=false

# ============================================
# 6. IDENTITY CHECK (Toden)
# ============================================
# Leave TODEN_SECRET_KEY unset to skip KYC entirely. The workflow id is in
# src/config/toden.json (it is not a secret). Webhook URL to register in Toden:
#   https://api-pay.3rike.com/webhook/toden
TODEN_API_URL=https://api.toden.co
TODEN_SECRET_KEY=
TODEN_WEBHOOK_SECRET=
# Only during a secret rotation: the old secret, still accepted.
# TODEN_WEBHOOK_SECRET_PREVIOUS=
# Testing: use https://sandbox-api.toden.co with sandbox keys, and fill
# sandboxWorkflowId in src/config/toden.json.

# ============================================
# 7. TUNING (all optional, sensible defaults)
# ============================================
# How long an invoice stays payable, in minutes (default 30). Raise it for demos.
# INVOICE_TTL_MINUTES=30
# Payout and top-up limits, in USD.
# Every rail has its own minimum and maximum (USD). Defaults: inbound 1Click min 5,
# max WITHDRAW_MAX_USD; payouts (1click-payout, autoramp) use WITHDRAW_MIN_USD/MAX_USD.
# Override one rail without touching the others:
# RAIL_1CLICK_MIN_USD=5
# RAIL_1CLICK_MAX_USD=
# RAIL_1CLICK_PAYOUT_MIN_USD=
# RAIL_AUTORAMP_MIN_USD=
# RAIL_AUTORAMP_MAX_USD=
# RAIL_DIRECT_USDC_MIN_USD=
# RAIL_DIRECT_USDC_MAX_USD=
# Direct USDC on Base: customers who already hold USDC pay the treasury with no swap and
# no 1Click minimum. Each payment is identified by an exact tagged amount, so it is off
# until you turn it on. TREASURY_ADDRESS must be an EVM address you control.
# DIRECT_USDC_ENABLED=true
# DIRECT_USDC_CONFIRMATIONS=3
# WITHDRAW_MIN_USD=5
# WITHDRAW_MAX_USD=2000
# WalletConnect project id for the pay page's wallet picker (free at https://dashboard.reown.com).
# Without it customers can still use a browser-extension wallet.
# WALLETCONNECT_PROJECT_ID=

# --- NEAR Intents advanced ---
# NEAR_INTENTS_BASE_URL=https://1click.chaindefuser.com
# Where refunds go if a swap fails (defaults to the recipient).
# NEAR_INTENTS_REFUND_TO=
# Partner referral code, if you have one.
# NEAR_INTENTS_REFERRAL=
# Units per 1 USD, merged over the built-in USD/RWF/NGN/KES/TZS/GHS rates.
# NEAR_INTENTS_FX_RATES={"KES":129,"TZS":2600,"NGN":1550}
# Live FX: only AutoRamp has a source (USD/NGN); other currencies use the table above.
# FX_LIVE_SOURCES=autoramp     (empty turns live rates off)
# FX_CACHE_SECONDS=300         reuse a live rate this long
# FX_MAX_AGE_SECONDS=900       never use a live rate older than this, even if the source is down
# FX_MAX_DEVIATION=0.25        reject a live rate this far from the table (likely bad data)
# MONEY_READS=minor            read balances from integer minor units; only after `npm run money:minor` shows no drift
# NEAR_INTENTS_SLIPPAGE_BPS=100
# NEAR_INTENTS_ORIGIN_ASSET=nep141:base-0x833589fcd6edb6e08f4c7c32d4f71b54bda02913.omft.near
# NEAR_INTENTS_DESTINATION_ASSET=nep141:base-0x833589fcd6edb6e08f4c7c32d4f71b54bda02913.omft.near
# NEAR_INTENTS_DESTINATION_DECIMALS=6
# NEAR-native treasury instead of an address on Base (payouts then cannot come
# from the Privy wallet, so leave this alone unless you know why):
# NEAR_INTENTS_RECIPIENT=your-treasury.near
# NEAR_INTENTS_RECIPIENT_TYPE=INTENTS

# --- Treasury advanced ---
# TREASURY_RPC_URL=https://mainnet.base.org
# TREASURY_TOKEN_CONTRACT=0x833589fcd6edb6e08f4c7c32d4f71b54bda02913
# TREASURY_TOKEN_DECIMALS=6

# ============================================
# 8. VERCEL (pay page hosting) - set in the Vercel project, not on Coolify
# ============================================
# The backend origin the pay page calls for invoice and merchant info.
# PAY_API_URL=https://api-pay.3rike.com

# ============================================
# 9. LOCAL DOCKER
# ============================================
# Publish ports on your machine when running `docker compose` locally. Do NOT
# set this on Coolify; there the proxy routes your domain to the app.
# COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml
# POSTGRES_USER=threerike
# POSTGRES_PASSWORD=threerike
# POSTGRES_DB=threerike_pay

# ============================================
# 10. OFF BY DEFAULT: legacy and mobile money
# ============================================
# Original Nigerian-banking features (BVN/NIN KYC, send to bank, airtime).
# LEGACY_BANKING_ENABLED=true
# Identity check through AutoRamp (BVN / NIN + OTP). Superseded by Toden.
# KYC_REQUIRED=true
# Mobile money invoice collection (Flutterwave). New invoices go via crypto instead.
# MOBILE_MONEY_ENABLED=true

# --- Flutterwave (only used when mobile money or an in-flight charge needs it) ---
# Keys: https://dashboard.flutterwave.com/dashboard/settings/apis
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
# true for live transactions; false/empty uses the Flutterwave sandbox
FLUTTERWAVE_PRODUCTION=false
# v4 credentials (push-notification charge flow); empty falls back to the v3 redirect link.
FLUTTERWAVE_CLIENT_ID=
FLUTTERWAVE_CLIENT_SECRET=
# FLUTTERWAVE_API_BASE=
# FLUTTERWAVE_TOKEN_URL=
# Sandbox only: sent as X-Scenario-Key on charges. Leave empty in production.
FLUTTERWAVE_SCENARIO_KEY=
# Subaccount split: TYPE is "percentage" or "flat"; VALUE is the merchant share (0.95 = 95%).
FLUTTERWAVE_SPLIT_TYPE=percentage
FLUTTERWAVE_SPLIT_VALUE=0.95

# --- WhatsApp Flows and templates (legacy forms; JSON files are the source of truth) ---
# src/config/flows.json and src/config/templates.json hold the ids and names.
# These variables only override them per environment.
# WHATSAPP_FLOW_KYC_ID=
# WHATSAPP_FLOW_SEND_MONEY_ID=
# WHATSAPP_FLOW_AIRTIME_ID=
# WHATSAPP_FLOW_BUSINESS_ID=
# WHATSAPP_FLOW_REVALIDATION_ID=
# WHATSAPP_FLOW_DRAFT_MODE=false
# WHATSAPP_TEMPLATE_LANG=en
# WHATSAPP_TEMPLATE_WELCOME=onboarding_message
# WHATSAPP_TEMPLATE_TRANSFER_COMPLETE=transfer_complete
# WHATSAPP_TEMPLATE_TRANSFER_FAILED=transfer_failed
# WHATSAPP_TEMPLATE_PAYMENT_RECEIVED=
# WHATSAPP_TEMPLATE_ACCOUNT_CREATED=
# WHATSAPP_TEMPLATE_KYC_APPROVED=
# WHATSAPP_TEMPLATE_KYC_REJECTED=
# WHATSAPP_TEMPLATE_KYC_OTP=
# WHATSAPP_TEMPLATE_LOGIN_OTP=
# WHATSAPP_TEMPLATE_LOW_BALANCE=
# WHATSAPP_TEMPLATE_REFERRAL_PROMO=
# WHATSAPP_TEMPLATE_REVALIDATION=
# WHATSAPP_TEMPLATE_WELCOME_PROMO=

# WhatsApp Flow encryption key (decrypts/encrypts Flow payloads).
# Priority: FLOW_PRIVATE_KEY (single-line PEM) > FLOW_PRIVATE_KEY_BASE64 > FLOW_PRIVATE_KEY_PATH (file).
# For deployment prefer FLOW_PRIVATE_KEY_BASE64 (no newlines). Never commit it.
# FLOW_PRIVATE_KEY=
# FLOW_PRIVATE_KEY_BASE64=
# FLOW_PRIVATE_KEY_PATH=/path/to/flow_private.pem
# FLOW_PRIVATE_KEY_PASSPHRASE=

# Dry-run mode: no AutoRamp calls, no DB writes, fake account number.
# (KYC_DRY_RUN is a legacy alias.)
DRY_RUN=false

# --- App identity ---
APP_NAME=3rike Pay
APP_CURRENCY=NGN
MERCHANT_EMAIL=merchant@example.com
MERCHANT_NAME=3rike Pay

# --- Stocks (tokenized stocks on Base) ---
# Every country is open except the United States.
# STOCKS_BLOCK_US=false
# Smallest and largest single order, in USD.
# STOCKS_MIN_ORDER_USD=5
# STOCKS_MAX_ORDER_USD=500
# How far below its quote a buy may fill before the venue must refuse it (basis points, 100 = 1%).
# STOCKS_MAX_SLIPPAGE_BPS=100
# An order whose quoted price impact is above this is refused before any money moves.
# STOCKS_MAX_PRICE_IMPACT_BPS=150
# A price older than this is shown as stale.
# STOCKS_NAV_MAX_AGE_SECONDS=86400
# --- The trading venue (the 0x Swap API, AllowanceHolder flow). ALL of these are needed; without
# them buying and selling stay off. Read docs/proposals/composable-rails.md section 13 first.
# DEMO MODE: STOCKS_VENUE=demo gives six simulated stocks with drifting prices and simulated fills. No chain, no real money, no 0x key.
# STOCKS_VENUE=0x
# STOCKS_0X_API_KEY=            keep it on the server only
# Contract addresses the treasury may call or approve, comma-separated, taken from 0x's documentation.
# Nothing the 0x API says to approve or call is used unless it is on this list.
# STOCKS_0X_ALLOWED_TARGETS=
# STOCKS_0X_BASE_URL=https://api.0x.org
# The Privy treasury wallet (PRIVY_*) must also be configured, and its Privy policy must allow ONLY
# the addresses above and the ERC-20 approve function.

# --- The stock research assistant (an AI model that explains and suggests; it never trades) ---
# Off without a key. Any OpenAI-compatible Chat Completions API works; the default is Meta's Model API.
# Use a model that does NOT train on your inputs (for Meta, never a "-contributor" model).
# Read the provider's privacy terms first: only stock facts and a share count are sent, never names or numbers.
# STOCKS_LLM_API_KEY=
# STOCKS_LLM_BASE_URL=https://api.meta.ai/v1
# STOCKS_LLM_MODEL=muse-spark-1.3
# STOCKS_LLM_REASONING_EFFORT=
# News and earnings for the research assistant (free key from finnhub.io). Without it the assistant says it cannot see news.
# STOCKS_NEWS_API_KEY=
# STOCKS_LLM_DAILY_LIMIT=20
