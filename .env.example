# ============================================
# 3rike Pay - WhatsApp Payment Bot
# ============================================
# Copy this to .env and fill in your values

# Server
PORT=3000
NODE_ENV=development

# Database - wired from env
# DEV (sqlite): DATABASE_URL=file:./prisma/dev.db  + npm run db:push:sqlite
# PROD (postgres): DATABASE_URL=postgresql://... + npm run db:push
DATABASE_URL=file:./prisma/dev.db

# WhatsApp Business API
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token

# Webhook
WEBHOOK_PATH=/webhook/whatsapp
WEBHOOK_SECRET=your_webhook_secret

# AutoRamp API
AUTORAMP_API_KEY=your_api_key_here
AUTORAMP_BASE_URL=https://autoramp-api.thebuidl.org
AUTORAMP_WEBHOOK_SECRET=your_autoramp_webhook_secret

# App
APP_NAME=3rike Pay
APP_CURRENCY=NGN
MERCHANT_EMAIL=merchant@example.com
MERCHANT_NAME=3rike Pay

# Logging
LOG_LEVEL=debug

# WhatsApp Flows - source of truth is src/config/flows.json
# (design ids + cta + firstScreen there). These env vars are optional
# overrides per environment; leave unset to use the JSON values.
# WHATSAPP_FLOW_KYC_ID=your_kyc_flow_id
# WHATSAPP_FLOW_SEND_MONEY_ID=your_send_money_flow_id
# WHATSAPP_FLOW_AIRTIME_ID=your_airtime_flow_id

# WhatsApp Message Templates - source of truth is src/config/templates.json
# (design names + language + params there; must match Meta approval).
# Optional overrides per environment; leave unset to use the JSON values.
# WHATSAPP_TEMPLATE_LANG=en
# WHATSAPP_TEMPLATE_WELCOME=onboarding_message
# WHATSAPP_TEMPLATE_KYC_OTP=kyc_otp
# WHATSAPP_TEMPLATE_KYC_APPROVED=kyc_approved
# WHATSAPP_TEMPLATE_KYC_REJECTED=kyc_rejected
# WHATSAPP_TEMPLATE_ACCOUNT_CREATED=account_created
# WHATSAPP_TEMPLATE_PAYMENT_RECEIVED=payment_received
# WHATSAPP_TEMPLATE_TRANSFER_COMPLETE=transfer_complete
# WHATSAPP_TEMPLATE_TRANSFER_FAILED=transfer_failed
# WHATSAPP_TEMPLATE_LOGIN_OTP=login_otp
# WHATSAPP_TEMPLATE_LOW_BALANCE=low_balance
# WHATSAPP_TEMPLATE_WELCOME_PROMO=welcome_promo
# WHATSAPP_TEMPLATE_REFERRAL_PROMO=referral_promo

# KYC Dry-run mode (no AutoRamp calls, no DB writes, fake account number)
KYC_DRY_RUN=false

# KYC Page URL (used in WhatsApp template links)
KYC_BASE_URL=https://yourdomain.com
